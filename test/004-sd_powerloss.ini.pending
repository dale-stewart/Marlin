#
# Test configuration with media and power-loss recovery
#
# Two features that only mean anything together: power-loss recovery writes its
# resume state to the media, and the thing it resumes is a print from that media.
# Neither compiles into the default test configuration, so between them they bring in
# `sd/` and `feature/powerloss`, and the half of `queue.cpp` that reads commands from a
# file rather than from the serial port.
#
[config:base]
ini_use_config             = base

# Unit tests must use BOARD_SIMULATED to run natively in Linux
motherboard                = BOARD_SIMULATED

# The media itself. No card is present in a test build; `DiskIODriver` is a pure virtual
# interface and `CardReader::changeMedia()` is public, so a test supplies its own
# block device rather than needing a disk image on the host.
sdsupport                  = on

# Power-loss recovery. Depends on media being present to store its resume state.
power_loss_recovery        = on

# Required, not decorative. Enabling media defines EVENT_GCODE_SD_ABORT as "G27", and
# SanityCheck.h guards that with
#   static_assert(nullptr == strstr(EVENT_GCODE_SD_ABORT, "G27"), ...)
# which is only a constant expression when the compiler folds strstr as a builtin — it
# does not at -O0, so without nozzle parking the build fails on "non-constant condition
# for static assertion" rather than on the message the check meant to print. See the
# defect register.
nozzle_park_feature        = on

# Auto-enabled with media, but BOARD_SIMULATED has no SD-detect pin, so Warnings.cpp
# reports it as unnecessary and this env builds with -Werror.
reinit_noisy_lcd           = off

# ---------------------------------------------------------------------------------
# PARKED — not yet part of the discovered set (`.pending`, so `test-marlin` skips it).
#
# The configuration is correct and builds. It cannot run yet because the fixture has no
# mounted volume: `EmptyCardSlot` in test/unit_tests.cpp reports an empty slot, which is
# honest but leaves `CardReader::root` unmounted, and `M502` then walks into defect #24
# (a null dereference in `jobRecoverFileExists`) and segfaults the binary.
#
# Unparking needs a RAM-backed block device holding a small formatted image, injected via
# `CardReader::changeMedia()`. That is the remaining Phase 4b work for this configuration
# — the seam is already there, only the fake filesystem is missing.
# ---------------------------------------------------------------------------------
